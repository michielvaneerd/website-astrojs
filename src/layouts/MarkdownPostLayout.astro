---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostPublishedLayout from "../layouts/PostPublishedLayout.astro";
import TagsLayout from "../layouts/TagsLayout.astro";
const { pageTitle, tags, pubDate } = Astro.props;
---

<BaseLayout pageTitle={pageTitle}>
    <h1>{pageTitle}</h1>
    <section class="article-info">
        <PostPublishedLayout pubDate={pubDate} />
        <TagsLayout tags={tags} />
    </section>
    <div class="article-content">
        <slot />
    </div>
</BaseLayout>
