---
import BaseLayout from "../layouts/BaseLayout.astro";
const { pageTitle, tags } = Astro.props;
---

<BaseLayout pageTitle={pageTitle}>
    <div class="tags">
        {
            tags.map((tag: string) => (
                <p class="tag">
                    <a href={`/tags/${tag}`}>{tag}</a>
                </p>
            ))
        }
    </div>
    <slot />
</BaseLayout>
